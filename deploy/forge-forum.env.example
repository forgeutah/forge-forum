# forge-forum configuration. Install as /etc/forge-forum.env, owner root,
# mode 0600. Process environment wins over this file.

# --- Required -----------------------------------------------------------

# The shared forge-proxy secret: the same PROXY_SECRET value forge-proxy
# and every other upstream app use. To rotate, list "new,old" here, roll
# the proxy, then drop the old value.
PROXY_SECRET=

# The Forge Utah Slack workspace ID (same SLACK_TEAM_ID as forge-proxy).
SLACK_TEAM_ID=

# The forum's address as members see it. forge-proxy rewrites Host, so the
# forum cannot work this out for itself. Used in every Slack link.
PUBLIC_BASE_URL=https://forum.forgeut.dev

# --- Optional -----------------------------------------------------------

# Where the "sign out" link points: forge-proxy's portal.
AUTH_PORTAL_URL=https://auth.forgeut.dev/

# The forge-proxy role that may moderate the forum.
ADMIN_ROLE=admin

LISTEN_ADDR=:8080
DB_PATH=/var/lib/forge-forum/forum.db
LOG_LEVEL=info

# --- Slack, through forge-bot (both settings, or neither) ------------------
# The forum holds no Slack token. forge-bot connects to Slack, forwards the
# forum's interactions to it, and passes its Slack API calls on. Without
# these the forum runs with announcements, reply direct messages, and
# "Move to forum" switched off.

# forge-bot's address on the tailnet, with no trailing slash, for example
# http://forge-bot:8080
FORGE_BOT_URL=
# The forum's service token, at least 32 characters: the same value as the
# forum's entry in forge-bot's SERVICE_TOKENS.
FORGE_BOT_TOKEN=
# Channel ID (C...) that hears about new threads. Empty: no announcements.
SLACK_ANNOUNCE_CHANNEL=

# --- Claude (needed only for "Move to forum") -----------------------------
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
